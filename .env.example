# Copy this file to .env and fill in your values.
# .env is not committed (see .gitignore).

# MongoDB connection string (required for products API).
# Examples:
#   Local:    mongodb://localhost:27017
#   Atlas:    mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# Database name (default: krishi-rakshak)
MONGODB_DB=krishi-rakshak

# Server port (default: 3000)
PORT=3000

# Optional: for Nominatim geocoder usage policy
# GEOCODER_EMAIL=your@email.com
